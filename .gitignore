runs/
results/*.jsonl
results/*.parquet
results/*.parquet.tmp
results/predictions/
plots/
# mirrored pod job logs + the watcher heartbeat log
logs/

# Pod harness: the connection details are ephemeral (per pod), kept local
scripts/pod/env.sh

