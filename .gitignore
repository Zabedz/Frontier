# The pipeline and `frontier plot` rebuild the result store and the figures on each
# run, so they are not committed. Heavy binaries are not either.
models/
checkpoints/
*.gguf
*.safetensors
*.bin
# cached teacher top-k logits for offline distillation
teacher_cache/
